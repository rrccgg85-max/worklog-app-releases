rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Simplified and ultra-robust rules for development and preview:
    // Allows full read/write access to authenticated users to prevent any permission issues.
    // =========================================================================
    
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    match /technicians/{techId} {
      allow read, write: if request.auth != null;
    }

    match /repair_cases/{caseId} {
      allow read, write: if request.auth != null;
    }

    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /admin_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /tech_users/{techId} {
      allow read, write: if request.auth != null;
    }

    match /system_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
